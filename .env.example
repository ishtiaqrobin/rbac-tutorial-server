# ─────────────────────────────────────────────────────────────────────────────
#  Backend environment configuration
#  Copy this file → .env  and adjust the values to match your machine.
# ─────────────────────────────────────────────────────────────────────────────

# Express server
NODE_ENV=development
PORT=5000

# PostgreSQL Database URL for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rbac_tutorial?schema=public"

# Better-Auth Configuration
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change_me_to_a_long_random_secret
BETTER_AUTH_URL=http://localhost:5000

# JWT Configuration (legacy/manual JWT usage reference)
JWT_SECRET=super_secret_jwt_key_rbac_tutorial_2026
JWT_EXPIRES_IN=1d

# Access Token (short-lived — used in HTTP-Only cookie for API requests)
ACCESS_TOKEN_SECRET=rbac_access_secret_2026_jwt_learning
ACCESS_TOKEN_EXPIRES_IN=1d

# Refresh Token (long-lived — used to issue new access tokens)
REFRESH_TOKEN_SECRET=super_secret_refresh_key_rbac_tutorial_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Frontend URL
FRONTEND_URL=http://localhost:3000