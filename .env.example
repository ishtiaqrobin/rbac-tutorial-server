# ─────────────────────────────────────────────────────────────────────────────
#  Backend environment configuration
#  Copy this file → .env  and adjust the values to match your machine.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=rbac_tutorial

# JWT settings
# A long, random string used to sign tokens.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=super_secret_key_change_me_in_production
JWT_EXPIRES_IN=24h

# Use this below type system 
# Express server
NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres@localhost:5432/ishtiaq_robin_db?schema=public"

BETTER_AUTH_SECRET=4YCXt4oJibshd6rFddnEacSR01Gnjp9B
BETTER_AUTH_URL=http://localhost:5000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT configuration
JWT_SECRET=very_secret_jwt_key_123456
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=very_secret_refresh_key_123456
REFRESH_TOKEN_EXPIRES_IN=30d